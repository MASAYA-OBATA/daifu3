package com.example.daifu3.data

data class Card(
    val suit: Suit,
    val rank: Rank,
    val id: String = if (rank == Rank.JOKER) "JOKER_${suit.ordinal}" else "${suit.symbol}${rank.symbol}"
) {
    val points: Int = when (rank) {
        Rank.THREE -> 3
        Rank.FOUR -> 4
        Rank.FIVE -> 5
        Rank.SIX -> 6
        Rank.SEVEN -> 7
        Rank.EIGHT -> 8
        Rank.NINE -> 9
        Rank.TEN -> 10
        Rank.JACK, Rank.QUEEN, Rank.KING -> 10
        Rank.ACE -> 15
        Rank.TWO -> 20
        Rank.JOKER -> 0  // 0点に修正（以前は50点）
    }

    val isJoker: Boolean = rank == Rank.JOKER

    override fun toString(): String {
        return if (isJoker) {
            // ジョーカーの場合、スートによって色の違いがわかるように
            if (suit == Suit.JOKER) "JOKER" else "${suit.symbol}JOKER"
        } else {
            // 通常のカードは「スート記号 + ランク記号」で表示
            "${suit.symbol}${rank.symbol}"
        }
    }
}